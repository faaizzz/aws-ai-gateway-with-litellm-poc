# Floor matches the use-case module's own - this module also uses ephemeral
# resources + write-only Secrets Manager arguments for the gateway
# master/salt/Langfuse keys.

terraform {
  required_version = ">= 1.11.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.100.0, < 6.0.0"
    }
    random = {
      source  = "hashicorp/random"
      version = ">= 3.7.0, < 4.0.0"
    }
  }
}
