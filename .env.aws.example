# Copy to .env.aws (gitignored) and fill in real values. Never commit .env.aws.
#
# AWS_PROFILE: a named profile in ~/.aws/credentials / ~/.aws/config for the
# deployer IAM user in your AWS account (eu-central-1). Set one up
# with `aws configure --profile ai-poc` (access key + secret key) if you
# don't already have one - the profile name itself is arbitrary, it just
# has to match what you export below.
export AWS_PROFILE=ai-poc
export AWS_REGION=eu-central-1
