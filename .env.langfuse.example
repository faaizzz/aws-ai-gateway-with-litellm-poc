# Copy to .env.langfuse (gitignored) and fill in real values. Never commit .env.langfuse.
#
# Get these from your Langfuse Cloud project settings (Settings -> API Keys).
export LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
export LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# Must be exactly this EU host - terraform/environments/dev/variables.tf
# has a validation block rejecting anything else (this deployment is pinned
# to the EU region; see "Langfuse EU host" below for why this is EU, not US,
# despite the naming looking backwards at first glance).
export LANGFUSE_HOST=https://cloud.langfuse.com
